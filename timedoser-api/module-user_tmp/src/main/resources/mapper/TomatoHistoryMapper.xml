<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="demo.tcyeee.mapper.TomatoHistoryMapper">
    <select id="getLastHistory" resultType="demo.tcyeee.entity.po.TomatoHistory">
        select *
        from time_doser.tomato_history
        where base_user_id = #{userId}
        order by create_time desc
        limit 1
    </select>
</mapper>