<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.timedoser.cloud.main.mapper.AclAuthMapper">
    <select id="getAll" resultType="com.timedoser.cloud.common.entity.po.AclAuth">
        select a.*,a.create_time as createTime
        from acl_auth a
        <if test="status != null">
            where a.enable = #{status}
        </if>
        order by a.id
    </select>
</mapper>