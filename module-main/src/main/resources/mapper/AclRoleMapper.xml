<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.timedoser.cloud.main.mapper.AclRoleMapper">
    <resultMap id="BaseResultMap" type="com.timedoser.cloud.common.entity.po.AclRole">
        <id column="id" jdbcType="INTEGER" property="id"/>
        <result column="name" jdbcType="VARCHAR" property="name"/>
        <result column="remark" jdbcType="VARCHAR" property="remark"/>
        <result column="create_time" jdbcType="TIMESTAMP" property="createTime"/>
    </resultMap>
    <sql id="Base_Column_List">
        id, `name`, remark, create_time
    </sql>
    <select id="findByUserId" resultType="com.timedoser.cloud.common.entity.po.AclRole">
        select b.*, b.create_time as createTime
        from time_doser_user.acl_user_role a
                 left join time_doser_user.acl_role b on a.role_id = b.id
        where a.user_id = #{id};
    </select>
</mapper>